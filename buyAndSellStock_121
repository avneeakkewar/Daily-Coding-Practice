class Solution {
    public int maxProfit(int[] prices) {
       int max = Integer.MIN_VALUE;
       int min = Integer.MAX_VALUE;
       int maxProfit =0;
       int i=0;
     
       while(i<prices.length){
        if( prices[i] < min){
            min = prices[i];
        }
        int profit = prices[i] - min;

        if(profit > maxProfit){
            maxProfit = profit;
        }
        i++;
        } 

        return maxProfit;

    }
}
